# wbook — copy to .env and fill in. Comments only on their own line (python-decouple keeps "# ..." after a value).
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
SITE_URL=http://localhost:8000
CSRF_TRUSTED_ORIGINS=

# Database: sqlite (MVP) or mysql
DB_ENGINE=sqlite
# DB_NAME=plat4user$wbook_prd
# DB_USER=plat4user
# DB_PASSWORD=
# DB_HOST=plat4user.mysql.pythonanywhere-services.com

# Files: local media/ (False) or private S3 (True)
USE_S3=False
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=sa-east-1

# Salt for hashed IP addresses (LGPD). Set once, never change after launch.
IP_HASH_SALT=change-me-too

# E-mail (Gmail with an app password). With DEBUG=True the console backend prints e-mails in the terminal
# (set EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend to really send while developing).
# Failed sends are written to the activity log (/operador/atividade/, category "email"), never shown as errors.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=wbook@gmail.com
# Gmail APP password (16 characters, no spaces) — docs/ai/08-deployment.md step 3
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=wbook <wbook@gmail.com>
SERVER_EMAIL=wbook@gmail.com
PLATFORM_CONTACT_EMAIL=wbook@gmail.com
# Receives 500-error e-mails (only with DEBUG=False)
ADMINS=wbook@gmail.com

MAX_UPLOAD_MB=20
MAX_PHOTO_MB=10
ADMIN_URL=admin/
